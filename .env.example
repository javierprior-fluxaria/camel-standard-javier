# ==============================================================================
# FLUXARIA MIDDLEWARE - VARIABLES DE ENTORNO (TWELVE-FACTOR CONFIG)
# ==============================================================================
# Copia este fichero a '.env' para sobreescribir variables en local o Docker Compose.
# En entornos Cloud (K8s, ECS, Azure Container Apps), inyecta estas variables
# a través de ConfigMaps y Secrets sin tocar el código empaquetado en el contenedor.
# ==============================================================================

# Puerto HTTP del servicio (Default: 8080)
PORT=8080

# Base de Datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/orders_db
DB_USER=fluxaria
DB_PASSWORD=fluxaria_password

# Apache Kafka Broker y Topics
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_BATCH_IN=orders.batch.in
KAFKA_TOPIC_BATCH_SUMMARY=orders.batch.summary
KAFKA_TOPIC_DLQ=orders.dlq
KAFKA_BATCH_GROUP=fluxaria-orders-batch-group

# ERP Legacy Endpoint (Default: simulador mock desacoplado)
ERP_BASE_URL=http://localhost:8080/api/mock-erp/erp/orders

# Perfil Activo de Spring Boot (Default: local)
SPRING_PROFILES_ACTIVE=local
